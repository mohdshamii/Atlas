# India Data Atlas — environment configuration
# Copy this file to .env and adjust values as needed.

# Base path if the app is served from a sub-directory (leave blank for root)
VITE_BASE_PATH=/

# App title shown in the browser tab
VITE_APP_TITLE="India Data Atlas"

# Future: base URL for a real data API (PostgREST / custom backend).
# When unset, the app uses bundled local JSON/GeoJSON as the data source.
VITE_API_BASE_URL=

# Future: map tile provider URL template (defaults to a free OSM tile source)
VITE_MAP_TILE_URL=https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png
